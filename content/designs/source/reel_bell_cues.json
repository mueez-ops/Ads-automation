{
 "lines": {
  "why": {
   "s": 0.05,
   "e": 1.779,
   "text": "why would anyone put a bell on a grave"
  },
  "alive": {
   "s": 1.829,
   "e": 3.843,
   "text": "in case the person inside wasn't dead"
  },
  "fear": {
   "s": 3.943,
   "e": 6.989,
   "text": "in the 1800s + people were terrified of being buried alive"
  },
  "built": {
   "s": 7.049,
   "e": 8.765,
   "text": "so inventors built safety coffins"
  },
  "cord": {
   "s": 8.825,
   "e": 11.899,
   "text": "wake up underground pull the cord and a bell rings above you"
  },
  "buried": {
   "s": 11.999,
   "e": 14.373,
   "text": "one inventor had himself buried to prove it worked"
  },
  "patents": {
   "s": 14.433,
   "e": 16.443,
   "text": "inventors filed at least 22 patents"
  },
  "nobody": {
   "s": 16.563,
   "e": 18.691,
   "text": "nobody is known to have been saved by one"
  },
  "product": {
   "s": 18.811,
   "e": 21.693,
   "text": "the bell was never the product peace of mind was"
  },
  "fearW": {
   "s": 21.913,
   "e": 22.788,
   "text": "find their fear"
  },
  "sell": {
   "s": 22.838,
   "e": 23.73,
   "text": "sell them the bell"
  },
  "scale": {
   "s": 23.88,
   "e": 25.768,
   "text": "we scale businesses with ads like this"
  },
  "dm": {
   "s": 25.848,
   "e": 28.254,
   "text": "DM us the word teardown for a free ad review"
  }
 },
