 "cues": {
  "lines": {
   "hook": {
    "s": 0.05,
    "e": 3.523,
    "text": "nobody tells you Mount Rushmore has a secret room behind Lincoln's head"
   },
   "sealed": {
    "s": 3.583,
    "e": 4.859,
    "text": "and something is sealed inside it"
   },
   "blast": {
    "s": 4.939,
    "e": 8.005,
    "text": "the sculptor blasted it out in 1938 + but never finished"
   },
   "vault": {
    "s": 8.085,
    "e": 11.01,
    "text": "in 1998 + they sealed a titanium vault in its floor"
   },
   "panels": {
    "s": 11.07,
    "e": 13.364,
    "text": "16 panels inside tell America's story"
   },
   "reveal": {
    "s": 13.664,
    "e": 15.96,
    "text": "left for people thousands of years from now"
   },
   "watched": {
    "s": 16.96,
    "e": 19.225,
    "text": "you've just watched this reel for 18 seconds"
   },
   "imagine": {
    "s": 19.375,
    "e": 21.076,
    "text": "imagine your ad held people that long"
   },
   "scale": {
    "s": 21.226,
    "e": 22.993,
    "text": "we scale businesses with ads like this"
   },
   "dm": {
    "s": 23.093,
    "e": 25.354,
    "text": "DM us the word teardown for a free ad review"
   }
