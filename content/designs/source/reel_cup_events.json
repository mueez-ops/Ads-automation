  "lines": {
   "why": {
    "s": 0.05,
    "e": 2.676,
    "text": "why would a company buy a stranger a brand new car"
   },
   "cup": {
    "s": 2.726,
    "e": 4.242,
    "text": "because her cup survived a fire"
   },
   "shell": {
    "s": 4.342,
    "e": 5.521,
    "text": "her car burned to a shell"
   },
   "fine": {
    "s": 5.581,
    "e": 8.013,
    "text": "but in the cupholder her Stanley cup was fine"
   },
   "ice": {
    "s": 8.073,
    "e": 9.422,
    "text": "and there was still ice inside"
   },
   "views": {
    "s": 9.522,
    "e": 11.406,
    "text": "her video got tens of millions of views"
   },
   "reply": {
    "s": 11.486,
    "e": 14.216,
    "text": "Stanley's president replied we'll replace your car"
   },
   "did": {
    "s": 14.276,
    "e": 15.029,
    "text": "and they did"
   },
   "made": {
    "s": 15.189,
    "e": 17.691,
