{
 "lines": {
  "why": {
   "s": 0.05,
   "e": 1.899,
   "text": "why would a bee sting you if it kills her"
  },
  "hive": {
   "s": 1.949,
   "e": 3.444,
   "text": "because she's defending the hive"
  },
  "barbs": {
   "s": 3.524,
   "e": 5.463,
   "text": "her stinger has barbs like a harpoon"
  },
  "rip": {
   "s": 5.523,
   "e": 7.731,
   "text": "it hooks in your skin and rips out of her body"
  },
  "pump": {
   "s": 7.791,
   "e": 9.979,
   "text": "and it keeps pumping venom for up to a minute"
  },
  "smell": {
   "s": 10.039,
   "e": 13.451,
   "text": "it also leaves a smell like bananas that marks you for the hive"
  },
  "tags": {
   "s": 13.531,
   "e": 15.989,
   "text": "one sting tags you the hive does the rest"
  },
  "ad": {
   "s": 16.149,
   "e": 19.453,
   "text": "your first ad doesn't need to sell it tags who's interested"
  },
  "next": {
   "s": 19.533,
   "e": 21.385,
   "text": "then your next ads find them and sell"
  },
  "scale": {
   "s": 21.535,
   "e": 23.423,
   "text": "we scale businesses with ads like this"
  },
  "dm": {
   "s": 23.503,
   "e": 25.91,
   "text": "DM us the word teardown for a free ad review"
  }
 },
