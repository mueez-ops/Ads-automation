{
 "lines": {
  "type": {
   "s": 0.05,
   "e": 1.41,
   "text": "you type a question to AI"
  },
  "never": {
   "s": 1.47,
   "e": 2.979,
   "text": "it never reads a single word of it"
  },
  "notone": {
   "s": 3.119,
   "e": 3.756,
   "text": "not one"
  },
  "how": {
   "s": 3.896,
   "e": 5.42,
   "text": "so how does it answer you in seconds"
  },
  "fiber": {
   "s": 5.52,
   "e": 9.937,
   "text": "your message is fired through fiber-optic cables as pulses of light to a data center"
  },
  "tokens": {
   "s": 10.017,
   "e": 12.69,
   "text": "there it's chopped into tokens chunks of about 4 letters"
  },
  "number": {
   "s": 12.75,
   "e": 13.993,
   "text": "each token becomes a number"
  },
  "thousands": {
   "s": 14.073,
   "e": 16.022,
   "text": "which points to a list of thousands of numbers"
  },
  "layers": {
   "s": 16.122,
   "e": 20.33,
   "text": "now the model runs dozens of layers where every token looks back at the ones before it"
  },
  "calc": {
   "s": 20.39,
   "e": 23.173,
   "text": "hundreds of billions of calculations for every token"
  },
  "scores": {
   "s": 23.273,
   "e": 25.734,
   "text": "next it scores every token it knows and picks one"
  },
  "again": {
   "s": 25.814,
   "e": 28.275,
   "text": "then it runs again and again one token at a time"
  },
  "types": {
   "s": 28.355,
   "e": 29.966,
   "text": "that's why answers type themselves out"
  },
  "math": {
   "s": 30.106,
   "e": 32.259,
   "text": "it never read your words it did math on them"
  },
  "watched": {
   "s": 32.959,
   "e": 35.35,
   "text": "you've just watched this reel for 34 seconds"
  },
  "imagine": {
   "s": 35.45,
   "e": 37.183,
   "text": "imagine your ad held people that long"
  },
  "scale": {
   "s": 37.283,
   "e": 39.027,
   "text": "we scale businesses with ads like this"
  },
  "dm": {
   "s": 39.127,
   "e": 41.486,
   "text": "DM us the word teardown for a free ad review"
  }
