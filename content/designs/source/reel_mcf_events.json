 "cues": {
  "lines": {
   "why": {
    "s": 0.05,
    "e": 2.169,
    "text": "why would anyone make a spoon with a hollow handle"
   },
   "mixer": {
    "s": 2.219,
    "e": 4.139,
    "text": "because the McFlurry spoon is the mixer"
   },
   "plug": {
    "s": 4.219,
    "e": 6.537,
    "text": "the machine plugs into the handle and spins it"
   },
   "whip": {
    "s": 6.597,
    "e": 8.432,
    "text": "it whips the toppings through the ice cream"
   },
   "stays": {
    "s": 8.492,
    "e": 10.504,
    "text": "then it stays in the cup and you eat with it"
   },
   "own": {
    "s": 10.564,
    "e": 12.265,
    "text": "so every cup gets its own mixer"
   },
   "jobs": {
    "s": 12.365,
    "e": 14.035,
    "text": "one spoon two jobs"
   },
   "ad": {
    "s": 14.195,
    "e": 16.437,
    "text": "your ad's first second needs two jobs too"
   },
   "stop": {
    "s": 16.517,
    "e": 18.359,
    "text": "stop the scroll and show what you sell"
   },
   "scale": {
    "s": 18.509,
    "e": 20.396,
    "text": "we scale businesses with ads like this"
   },
   "dm": {
    "s": 20.476,
    "e": 22.883,
    "text": "DM us the word teardown for a free ad review"
   }
