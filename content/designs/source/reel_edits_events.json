 "cues": {
  "lines": {
   "stop": {
    "s": 0.05,
    "e": 1.775,
    "text": "stop editing your ads every day"
   },
   "costing": {
    "s": 1.875,
    "e": 3.155,
    "text": "here's what it's costing you"
   },
   "monday": {
    "s": 3.375,
    "e": 4.69,
    "text": "Monday a new headline"
   },
   "tuesday": {
    "s": 4.79,
    "e": 6.133,
    "text": "Tuesday a bigger budget"
   },
   "wednesday": {
    "s": 6.233,
    "e": 7.655,
    "text": "Wednesday a new audience"
   },
   "feels": {
    "s": 7.875,
    "e": 9.043,
    "text": "feels like progress"
   },
   "isnt": {
    "s": 9.203,
    "e": 9.941,
    "text": "it isn't"
   },
   "every": {
    "s": 10.161,
    "e": 13.264,
    "text": "every one of those edits sends your ad set back into learning"
   },
   "needs": {
    "s": 13.324,
    "e": 16.668,
    "text": "and Meta needs about 50 results in 7 days to finish"
   },
   "daily": {
    "s": 16.868,
    "e": 18.774,
    "text": "edit daily and it never finishes"
   },
   "pays": {
    "s": 18.954,
    "e": 21.137,
    "text": "your budget pays for learning not selling"
   },
   "make": {
    "s": 21.357,
    "e": 22.847,
    "text": "make your changes in one go"
   },
   "leave": {
    "s": 22.897,
    "e": 24.86,
    "text": "then leave the ad alone for 7 days"
   },
   "boring": {
    "s": 25.12,
    "e": 28.701,
    "text": "boring ads that keep running beat clever ads that keep restarting"
   }
  },
