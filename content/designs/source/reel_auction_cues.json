  "hook": {
   "s": 0.05,
   "e": 3.367,
   "text": "nobody tells you a cheaper ad can beat yours on Instagram"
  },
  "auction": {
   "s": 3.517,
   "e": 5.674,
   "text": "every ad you see there won an auction first"
  },
