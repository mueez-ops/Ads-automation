{
 "cues": {
  "lines": {
   "why": {
    "s": 0.05,
    "e": 2.346,
    "text": "why would anyone push a hot dog into a saw blade"
   },
   "salty": {
    "s": 2.446,
    "e": 4.593,
    "text": "because it's about as salty and wet as a finger"
   },
   "stops": {
    "s": 4.713,
    "e": 6.677,
    "text": "and this saw stops before it can take one"
   },
   "signal": {
    "s": 6.777,
    "e": 8.743,
    "text": "the blade carries a tiny electrical signal"
   },
   "wood": {
    "s": 8.823,
    "e": 14.596,
    "text": "cutting wood barely changes it but skin conducts electricity so the instant it touches a tooth the signal changes"
   },
   "brake": {
    "s": 14.656,
    "e": 16.813,
    "text": "a spring fires an aluminum brake into the teeth"
   },
   "stop": {
    "s": 16.873,
    "e": 20.335,
    "text": "the blade stops dead in under 5 milliseconds and drops under the table"
   },
   "blink": {
    "s": 20.395,
    "e": 21.312,
    "text": "faster than a blink"
   },
   "nick": {
    "s": 21.412,
    "e": 22.591,
    "text": "the hot dog gets a nick"
   },
   "cost": {
    "s": 22.711,
    "e": 26.286,
    "text": "but it costs the saw the brake is single-use and the blade's usually ruined"
   },
   "offered": {
    "s": 26.406,
    "e": 28.687,
    "text": "its inventor offered it to the big tool companies"
   },
   "sell": {
    "s": 28.767,
    "e": 30.867,
    "text": "he says they told him safety doesn't sell"
   },
   "own": {
    "s": 31.007,
    "e": 32.714,
    "text": "so he started his own saw company"
   },
   "watched": {
    "s": 33.414,
    "e": 35.804,
    "text": "you've just watched this reel for 34 seconds"
   },
   "imagine": {
    "s": 35.904,
    "e": 37.637,
    "text": "imagine your ad held people that long"
   },
   "scale": {
    "s": 37.737,
    "e": 39.581,
    "text": "we scale businesses with ads like this"
   },
   "dm": {
    "s": 39.681,
    "e": 42.04,
    "text": "DM us the word teardown for a free ad review"
   }
