{
 "cues": {
  "lines": {
   "why": {
    "s": 0.05,
    "e": 2.429,
    "text": "why would anyone drill a tiny hole in a gas nozzle"
   },
   "stop": {
    "s": 2.479,
    "e": 3.921,
    "text": "so the pump knows when to stop"
   },
   "rush": {
    "s": 4.021,
    "e": 6.587,
    "text": "as gas rushes through it sucks air in through the hole"
   },
   "full": {
    "s": 6.667,
    "e": 8.882,
    "text": "when your tank is full the gas covers the hole"
   },
   "noair": {
    "s": 8.942,
    "e": 9.73,
    "text": "no more air"
   },
   "snap": {
    "s": 9.79,
    "e": 12.743,
    "text": "the suction yanks a little diaphragm and the valve snaps shut"
   },
   "just": {
    "s": 12.863,
    "e": 15.093,
    "text": "no sensors no electronics just a hole"
   },
   "need": {
    "s": 15.273,
    "e": 16.465,
    "text": "your ads need that hole"
   },
   "or": {
    "s": 16.525,
    "e": 18.807,
    "text": "or they keep pumping money after they stop working"
   },
   "know": {
    "s": 18.907,
    "e": 19.953,
    "text": "know when to stop"
   },
   "scale": {
    "s": 20.103,
    "e": 21.991,
    "text": "we scale businesses with ads like this"
   },
   "dm": {
    "s": 22.071,
    "e": 24.478,
    "text": "DM us the word teardown for a free ad review"
   }
  },
