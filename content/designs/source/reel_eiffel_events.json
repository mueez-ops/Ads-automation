   "hook": {
    "s": 0.05,
    "e": 3.161,
    "text": "nobody tells you the Eiffel Tower has a secret apartment at the top"
   },
   "built": {
    "s": 3.221,
    "e": 4.851,
    "text": "Gustave Eiffel built it for himself"
   },
   "offers": {
    "s": 4.911,
    "e": 7.417,
    "text": "rich Parisians offered fortunes to rent it for one night"
   },
   "no": {
    "s": 7.467,
    "e": 8.641,
    "text": "he said no to all of them"
   },
   "guest": {
    "s": 8.721,
    "e": 10.721,
    "text": "his most famous guest Thomas Edison"
   },
   "wax": {
    "s": 10.801,
    "e": 11.916,
    "text": "and they're both still up there"
   },
   "reveal": {
    "s": 12.216,
    "e": 13.039,
    "text": "in wax"
   },
   "watched": {
    "s": 14.039,
    "e": 16.304,
    "text": "you've just watched this reel for 15 seconds"
   },
   "imagine": {
    "s": 16.454,
    "e": 18.155,
    "text": "imagine your ad held people that long"
   },
   "scale": {
    "s": 18.305,
    "e": 20.072,
    "text": "we scale businesses with ads like this"
   },
   "dm": {
    "s": 20.172,
    "e": 22.433,
    "text": "DM us the word teardown for a free ad review"
   }
