 "cues": {
  "lines": {
   "hook": {
    "s": 0.05,
    "e": 3.405,
    "text": "nobody tells you the Eiffel Tower has a secret apartment at the top"
   },
   "built": {
    "s": 3.525,
    "e": 5.442,
    "text": "Gustave Eiffel built it for himself"
   },
   "offers": {
    "s": 5.562,
    "e": 8.483,
    "text": "Paris's rich offered fortunes to rent it for one night"
   },
   "no": {
    "s": 8.533,
    "e": 9.898,
    "text": "he said no to all of them"
   },
   "guest": {
    "s": 10.018,
    "e": 12.257,
    "text": "his most famous guest Thomas Edison"
   },
   "wax": {
    "s": 12.377,
    "e": 14.51,
    "text": "and they're both still up there in wax"
   },
   "watched": {
    "s": 15.51,
    "e": 18.105,
    "text": "you've just watched this reel for 17 seconds"
   },
   "imagine": {
    "s": 18.355,
    "e": 20.33,
    "text": "imagine your ad held people that long"
   },
   "scale": {
    "s": 20.58,
    "e": 22.633,
    "text": "we scale businesses with ads like this"
   },
   "dm": {
    "s": 22.783,
    "e": 25.452,
    "text": "DM us the word teardown for a free ad review"
   }
  },
